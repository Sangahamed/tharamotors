APP_NAME=Tharamotors
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tharamotors.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# Base MySQL creee depuis cPanel > Bases de donnees MySQL.
# cPanel prefixe systematiquement avec le nom du compte : tharamotors_xxx
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tharamotors_prod
DB_USERNAME=tharamotors_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Compte email cree depuis cPanel > Comptes de messagerie.
MAIL_MAILER=smtp
MAIL_HOST=mail.tharamotors.com
MAIL_PORT=465
MAIL_USERNAME=contact@tharamotors.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="contact@tharamotors.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_DEVIS_RECIPIENT=contact@tharamotors.com

VITE_APP_NAME="${APP_NAME}"
